{
  // Pubblicazione su Cloudflare Workers: serve la cartella site/ come sito statico,
  // ma ogni richiesta passa prima da worker/index.js, che chiede la password.
  "name": "my-lectures",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
