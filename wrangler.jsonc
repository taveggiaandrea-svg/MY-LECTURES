{
  // Pubblicazione su Cloudflare Workers: serve la cartella site/ come sito statico,
  // ma ogni richiesta passa prima da worker/index.js, che chiede la password.
  "name": "my-lectures",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  // Archivio delle domande all'assistente: Durable Object con SQLite, creato al primo deploy.
  "durable_objects": { "bindings": [{ "name": "DOMANDE", "class_name": "Domande" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Domande"] }]
}
